<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/anhnen1"
    android:padding="20dp"
    tools:context=".info.info">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textViewUsernameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/white_background2_1"
            android:padding="16dp"
            android:text="Tên đăng nhập"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/textViewUsername"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/white_background2"
            android:padding="16dp"
            android:gravity="end"
            android:textColor="@color/black"
            android:hint="Cập nhật ngay" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/textViewPhoneLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/white_background2_1"
            android:padding="16dp"
            android:textColor="@color/black"
            android:text="Số điện thoại" />

        <TextView
            android:id="@+id/textViewPhone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/white_background2"
            android:padding="16dp"
            android:gravity="end"
            android:hint="Cập nhật ngay"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/textViewTuoiLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/white_background2_1"
            android:padding="16dp"
            android:textColor="@color/black"
            android:text="Tuổi" />

        <TextView
            android:id="@+id/textViewTuoi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/white_background2"
            android:padding="16dp"
            android:gravity="end"
            android:textColor="@color/black"
            android:hint="Cập nhật ngay"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/textViewGtLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/white_background2_1"
            android:padding="16dp"
            android:textColor="@color/black"
            android:text="Giới tính" />

        <TextView
            android:id="@+id/textViewGt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/white_background2"
            android:padding="16dp"
            android:gravity="end"
            android:hint="Cập nhật ngay"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/textViewDateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/white_background2_1"
            android:padding="16dp"
            android:textColor="@color/black"
            android:text="Ngày tháng năm sinh" />

        <TextView
            android:id="@+id/textViewDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/white_background2"
            android:padding="16dp"
            android:gravity="end"
            android:hint="Cập nhật ngay"/>

    </LinearLayout>


    <Button
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:id="@+id/back_button"
        android:text="Quay lại"
        android:textSize="15dp"
        android:layout_marginTop="25dp"
        android:background="@drawable/rounded_button_bg"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:id="@+id/dmk_button"
        android:text="Đổi mật khẩu"
        android:textSize="15dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/rounded_button_bg"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:id="@+id/logout_button"
        android:text="Đăng xuất"
        android:textSize="15dp"
        android:layout_marginTop="25dp"
        android:onClick="logoutClick"
        android:background="@drawable/rounded_button_bg"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:id="@+id/delete_button"
        android:text="Xóa tài khoản"
        android:textSize="15dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/rounded_button_bg"/>

</LinearLayout>