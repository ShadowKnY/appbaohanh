<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".add_edit_delete.addActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:textStyle="bold"
            android:textColor="@color/purple_Dark"
            android:textSize="30dp"
            android:layout_marginTop="40dp"
            android:text="SỬA, XÓA SẢN PHẨM"/>


        <EditText
            android:id="@+id/title_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/textView1"
            android:layout_marginStart="20dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="20dp"
            android:inputType="textMultiLine|textCapSentences"
            android:hint="Tên sản phẩm" />

        <EditText
            android:id="@+id/description_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/title_txt"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="20dp"
            android:inputType="textMultiLine|textCapSentences"
            android:hint="Mô tả sản phẩm" />

        <EditText
            android:id="@+id/price_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/description_txt"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="20dp"
            android:inputType="textMultiLine|textCapSentences"
            android:hint="Mức giá" />

        <EditText
            android:id="@+id/picUrl_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/price_txt"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="20dp"
            android:inputType="textMultiLine|textCapSentences"
            android:hint="URL ảnh" />

        <EditText
            android:id="@+id/review_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/picUrl_txt"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="20dp"
            android:inputType="textMultiLine|textCapSentences"
            android:hint="Số lượt đánh giá" />

        <EditText
            android:id="@+id/score_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/review_txt"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="20dp"
            android:inputType="textMultiLine|textCapSentences"
            android:hint="Điểm đánh giá" />

        <EditText
            android:id="@+id/numberInChart_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/score_txt"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="20dp"
            android:inputType="textMultiLine|textCapSentences"
            android:hint="Number In Chart" />

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/numberInChart_txt"
            android:layout_marginStart="35dp"
            android:layout_marginTop="13dp"
            android:layout_marginEnd="35dp"
            android:text="Lưu" />

        <!-- Thêm nút Xóa -->
        <Button
            android:id="@+id/deleteBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/numberInChart_txt"
            android:layout_marginTop="12dp"
            android:layout_toEndOf="@id/saveBtn"
            android:layout_marginStart="90dp"
            android:text="Xóa" />

    </RelativeLayout>
</ScrollView>